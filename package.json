{
  "name": "boomerang.app.flow",
  "version": "3.12.0",
  "private": true,
  "engines": {
    "node": ">=22.22.0"
  },
  "homepage": "https://useboomerang.io",
  "sideEffects": false,
  "scripts": {
    "analyze": "source-map-explorer build/static/js/*.js",
    "build": "cross-env NODE_OPTIONS=--experimental-global-webcrypto react-scripts build && ncp build server/build",
    "build:rewriteAssetPaths": "cross-env APP_ROOT=/local node server/scripts/rewriteAssetPaths.js",
    "cypress": "cypress open",
    "docker": "cross-env NODE_ENV=test run-s docker:build docker:run",
    "docker:build": "docker build -t flow:next .",
    "docker:run": "docker run -i -t -p 3000:3000 -e APP_ROOT=/app -e CORE_SERVICE_ENV_URL=http://localhost:8000 flow:next",
    "eject": "react-scripts eject",
    "lint": "eslint -o lint-report.json ./src",
    "lint:staged": "eslint ./src",
    "prod": "run-s build prod:rewriteAssetPaths prod:server",
    "prod:rewriteAssetPaths": "cross-env APP_ROOT=/local node server/scripts/rewriteAssetPaths.js",
    "prod:server": "cd server && pnpm dev",
    "start": "vite",
    "start:pf": "vite --mode portforward",
    "start:test": "vite --mode test",
    "test": "cross-env TZ=UTC vitest",
    "test:ui": "cross-env TZ=UTC vitest --ui",
    "test:ci": "cross-env TZ=UTC vitest --coverage",
    "test:ci-cypress": "start-server-and-test start:test http://127.0.0.1:3000 cypress:run",
    "test:staged": "cross-env TZ=UTC CI=true vitest related --changed --passWithNoTests",
    "upgradePackage": "node scripts/upgradePackage",
    "preview": "vite preview",
    "prepare": "husky install",
    "precommit": "lint-staged"
  },
  "dependencies": {
    "@boomerang-io/carbon-addons-boomerang-react": "4.1.2-beta.0",
    "@boomerang-io/styles": "1.1.0",
    "@boomerang-io/utils": "1.1.0",
    "@carbon/charts": "^1.13.6",
    "@carbon/charts-react": "^1.13.6",
    "@carbon/pictograms-react": "^11.50.0",
    "@carbon/react": "1.59.0",
    "@dagrejs/dagre": "^1.0.4",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "axios": "^0.27.2",
    "axios-hooks": "^3.0.1",
    "change-case": "^4.1.2",
    "classnames": "^2.3.2",
    "codemirror": "^5.58.2",
    "copy-to-clipboard": "^3.3.1",
    "cronstrue": "^2.21.0",
    "d3": "^7.4.4",
    "deep-object-diff": "^1.1.7",
    "detect-browser": "^5.3.0",
    "flagged": "^2.0.1",
    "formik": "^2.4.5",
    "immer": "^9.0.6",
    "js-file-download": "^0.4.4",
    "match-sorter": "^2.3.0",
    "moment-timezone": "^0.5.45",
    "pathfinding": "^0.4.18",
    "paths-js": "^0.4.10",
    "postcss-flexbugs-fixes": "^5.0.2",
    "prop-types": "15.8.1",
    "query-string": "^6.14.1",
    "react": "^17.0.1",
    "react-beautiful-dnd": "^13.1.0",
    "react-big-calendar": "^1.5.2",
    "react-codemirror2": "^7.2.1",
    "react-copy-to-clipboard": "^5.0.1",
    "react-dom": "^17.0.1",
    "react-dropzone": "^14.2.3",
    "react-error-boundary": "^2.3.1",
    "react-helmet": "^6.1.0",
    "react-joyride": "^2.5.5",
    "react-json-view": "^1.21.1",
    "react-lazylog": "4.5.3",
    "react-markdown": "^8.0.3",
    "react-mde": "11.5.0",
    "react-query": "^3.34.12",
    "react-router-dom": "5.3.0",
    "react-sliding-pane": "^7.1.0",
    "react-transition-group": "^4.4.2",
    "reactflow": "^11.5.2",
    "reflexbox": "^4.0.6",
    "typeface-ibm-plex-sans": "1.1.13",
    "underscore": "^1.13.8",
    "use-immer": "^0.4.0",
    "validator": "^10.7.1",
    "yup": "^0.32.11"
  },
  "devDependencies": {
    "@commitlint/cli": "18.2.0",
    "@commitlint/config-conventional": "18.1.0",
    "@testing-library/cypress": "^9.0.0",
    "@testing-library/jest-dom": "^5.16.4",
    "@testing-library/react": "^12.1.2",
    "@testing-library/react-hooks": "^8.0.1",
    "@testing-library/user-event": "^13.5.0",
    "@types/lodash": "^4.14.157",
    "@types/node": "^14.0.22",
    "@types/react": "^16.9.43",
    "@types/react-beautiful-dnd": "^13.0.0",
    "@types/react-big-calendar": "^0.38.3",
    "@types/react-copy-to-clipboard": "^4.3.0",
    "@types/react-dom": "^16.9.8",
    "@types/react-helmet": "^6.0.0",
    "@types/react-router-dom": "^5.3.3",
    "@types/reflexbox": "^4.0.1",
    "@types/validator": "^13.1.0",
    "@types/yup": "^0.29.3",
    "@vitejs/plugin-react": "^4.1.0",
    "@vitest/ui": "^0.34.6",
    "autoprefixer": "^10.4.16",
    "c8": "^8.0.1",
    "cross-env": "7.0.2",
    "cypress": "^12.3.0",
    "cypress-vite": "1.4.2",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "^8.52.0",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-cypress": "^2.12.1",
    "eslint-plugin-testing-library": "5.0.1",
    "husky": "^8.0.3",
    "jsdom": "^22.1.0",
    "lint-staged": "10.1.1",
    "miragejs": "^0.1.47",
    "ncp": "^2.0.0",
    "npm-run-all": "4.1.5",
    "prettier": "3.0.3",
    "react-test-renderer": "^16.13.1",
    "sass": "^1.50.0",
    "source-map-explorer": "^2.4.2",
    "start-server-and-test": "^1.10.11",
    "ts-loader": "^9.2.8",
    "typescript": "^4.5.4",
    "typescript-plugin-css-modules": "^3.4.0",
    "uuid": "^14.0.0"
  },
  "pnpm": {
    "overrides": {
      "axios": "^1.18.0",
      "@babel/runtime": "^7.29.6",
      "@tootallnate/once": "2.0.1",
      "body-parser": "1.20.6",
      "brace-expansion": "^5.0.10",
      "immutable": "4.3.9",
      "postcss": "8.5.23",
      "svgo": "2.8.4",
      "eslint>js-yaml": "4.3.2",
      "svgo>js-yaml": "3.15.2",
      "react-dev-utils>shell-quote": "^1.11.0",
      "launch-editor>shell-quote": "^1.11.0",
      "@istanbuljs/load-nyc-config>js-yaml": "3.15.2",
      "serialize-javascript": "7.0.5",
      "json5": "^1.0.2",
      "underscore": "1.13.8",
      "ws": "^8.21.0",
      "decode-uri-component": "^0.5.0",
      "nth-check": "2.1.1",
      "loader-utils": "^1.4.1",
      "ejs": "3.1.10",
      "lodash": "^4.18.0",
      "lodash-es": "^4.18.0",
      "lodash-amd": "^4.18.0",
      "lodash-template": "^4.18.0",
      "dompurify": "^3.2.4",
      "cross-spawn": "^7.0.5",
      "braces": "^3.0.3",
      "cssom": "0.5.0",
      "protobufjs": "7.6.5",
      "qs": "^6.16.0",
      "validator": "^13.15.22",
      "webpack-dev-server": "5.2.6",
      "node-forge": "1.4.0",
      "compression": "1.8.2",
      "proxy-addr": "2.0.8",
      "@cypress/request>uuid": "8.3.2",
      "uuid": "^14.0.0"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,scss,css,md}": [
      "prettier --print-width 120 --write"
    ],
    "src/**/*.{js,jsx,ts,tsx}": [
      "pnpm lint:staged",
      "pnpm test:staged"
    ]
  },
  "jest": {
    "moduleNameMapper": {
      "^axios$": "axios/dist/node/axios.cjs"
    },
    "collectCoverageFrom": [
      "!**/*.spec.{js,jsx}",
      "!**/Assets/**",
      "!**/ApiServer/**",
      "**/src/Components/**/*.{js,jsx}",
      "**/src/Features/**/*.{js,jsx}",
      "**/src/Hooks/**/*.{js,jsx}",
      "**/src/State/**/*.{js,jsx}",
      "**/src/Utils/**/*.{js,jsx}"
    ]
  }
}
